{
  "name": "slightsftp",
  "version": "1.6.0",
  "description": "Multi-user FTP/SFTP server with GUI management",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const path=require('path');if(!fs.existsSync('dist/assets'))fs.mkdirSync('dist/assets',{recursive:true});fs.copyFileSync('assets/icon.png','dist/assets/icon.png');fs.copyFileSync('src/index.html','dist/index.html');fs.copyFileSync('src/login.html','dist/login.html');fs.copyFileSync('src/admin.html','dist/admin.html');fs.copyFileSync('src/renderer.js','dist/renderer.js');fs.copyFileSync('src/portal.html','dist/portal.html');fs.copyFileSync('src/share.html','dist/share.html');\"",
    "start": "npm run build && electron --no-sandbox dist/main.js",
    "start:web": "npm run build && node dist/web-only.js",
    "dev": "tsc && electron --no-sandbox dist/main.js",
    "dev:web": "tsc && node dist/web-only.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:web": "npm run build && playwright test --project=web-gui",
    "test:e2e:electron": "npm run build && playwright test --project=electron-gui",
    "test:all": "npm test -- --runInBand --forceExit && npm run test:e2e",
    "test:client": "npm run build && node dist/test-client.js",
    "setup:testusers": "npm run build && node dist/setup-test-users.js",
    "test:comprehensive": "npm run setup:testusers && npm run test:client",
    "test:auto": "npm run build && powershell -ExecutionPolicy Bypass -File run-tests-with-server.ps1",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64"
  },
  "keywords": [
    "ftp",
    "sftp",
    "server",
    "electron",
    "gui"
  ],
  "author": {
    "name": "Sujith Gunawardhane",
    "email": "sujithsg@gmail.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.slightsftp.app",
    "productName": "SLightSFTP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/index.html",
      "src/login.html",
      "src/renderer.js",
      "src/admin.html",
      "src/portal.html",
      "src/share.html",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/@azure/*/dist/{browser,esm,react-native}/**",
      "!node_modules/@aws-sdk/*/dist-{es,types}/**",
      "!node_modules/@smithy/*/dist-{es,types}/**",
      "!node_modules/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "linux": {
      "category": "Utility",
      "maintainer": "Sujith Gunawardhane <sujithsg@gmail.com>"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SLightSFTP Server",
      "menuCategory": false,
      "artifactName": "${productName}-${version}-setup.${ext}",
      "warningsAsErrors": false,
      "runAfterFinish": false
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@azure/storage-blob": "^12.34.0",
    "basic-ftp": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ftp-srv": "^4.6.3",
    "ldapts": "9.2.0",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "sql.js": "^1.10.3",
    "ssh2": "^1.15.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ftp": "^0.3.36",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.27",
    "@types/qrcode": "1.5.5",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.11.17",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "azurite": "^3.37.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "ftp": "^0.3.10",
    "icon-gen": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "ldapjs": "3.0.7",
    "png-to-ico": "^3.0.1",
    "ssh2-sftp-client": "^12.0.1",
    "supertest": "^7.2.2",
    "to-ico": "^1.1.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
